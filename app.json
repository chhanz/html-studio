{
  "name": "html-studio",
  "version": "0.1.20",
  "displayName": "HTML Studio",
  "description": "View, edit, check and present HTML slide decks. Point at an element in the live preview, leave a comment, and let the agent apply the change.",
  "author": "Cheolhee Han",
  "license": "MIT",
  "minKiroCrewVersion": "0.1.0",
  "iconPath": "assets/icon.svg",
  "tags": [
    "design",
    "presentation",
    "html",
    "slides",
    "visual-editing"
  ],
  "agents": [],
  "skills": [],
  "ui": {
    "entry": "dist/index.mjs",
    "pages": [
      {
        "route": "/apps/html-studio",
        "label": "HTML Studio",
        "icon": "Presentation",
        "iconUrl": "dist/icons/nav.svg",
        "iconInactiveUrl": "dist/icons/nav-inactive.svg"
      }
    ]
  },
  "backend": {
    "entryPoint": "backend/server.py",
    "port": "auto",
    "healthCheck": "/health"
  },
  "permissions": {
    "api": [
      "/apps/html-studio/api",
      "/apps/html-studio/api/*",
      "/api/chat",
      "/api/chat/slots"
    ],
    "storage": true
  }
}
